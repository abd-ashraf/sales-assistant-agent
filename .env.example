# Copy to .env and fill in. .env is git-ignored: keys never reach the repository.
OPENAI_API_KEY=

# The model for ingest and answers; gpt-6-luna is the cheaper one it was compared with.
OPENAI_MODEL=gpt-6.1-sol

# The assignment's data folder, relative to where you run the command.
# DATA_DIR=data

# Optional: trace every question in a local Langfuse (see the README). Tracing is on
# only when all three are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
